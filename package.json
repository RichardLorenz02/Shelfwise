{
  "name": "shelfwise-library-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Group 6 BSCS C3A: MERN Library Management System (frontend / backend / database)",
  "workspaces": ["database", "backend", "frontend"],
  "scripts": {
    "setup": "npm install && node scripts/setup-env.js",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix database",
    "test": "npm test --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "vercel-build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}