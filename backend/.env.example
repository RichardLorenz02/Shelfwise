# Copy this file to .env (npm run setup does this for you). The database URI lives in database/.env
NODE_ENV=development
PORT=5000
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Library policy
LOAN_DAYS=14
MAX_ACTIVE_LOANS=5
# Admins may borrow for themselves only if enabled (proposal: "Allowed if enabled")
ADMIN_CAN_BORROW=false
# Admins may change user roles only if school policy permits it
ALLOW_ROLE_CHANGES=false

# Overdue rule: this many overdue books suspends the reader's account (they can then appeal to a librarian)
OVERDUE_SUSPEND_LIMIT=5
# After an approved appeal, how many days the overdue rule is paused so the books can be returned
APPEAL_GRACE_DAYS=7
